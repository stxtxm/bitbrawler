# Supabase configuration
# Copy this file to .env and fill in your values

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon key for client (find in Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im...

# Supabase management API access token (generated from Settings > API)
# Required for automatic migration execution
# SUPABASE_ACCESS_TOKEN=sbap_abc123...

# Script variables (set in GitHub Secrets)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im...

# Web Push (VAPID) — used by scripts/push-notifier.ts (set in GitHub Secrets)
# Generate a pair with: npx web-push generate-vapid-keys --json
# The PUBLIC key must match DEFAULT_VAPID_PUBLIC_KEY in src/utils/pushNotifications.ts
# The PRIVATE key must NEVER be committed — GitHub secret only
# VAPID_PUBLIC_KEY=your-public-key-here
# VAPID_PRIVATE_KEY=your-private-key-here
# VAPID_SUBJECT=mailto:you@example.com
