# Supabase — switch réversible entre 2 comptes/projets
# ============================================================
# Comment switcher :
#   1. Coller les valeurs du projet ACTIF dans les 4 vars ci-dessous
#   2. Garder l'ancien projet en commentaire (LEGACY) pour revert en 1 copier-coller
#   3. Mettre à jour les mêmes 4 vars dans :
#        - Vercel > Settings > Environment Variables (VITE_*)
#        - GitHub > Settings > Secrets and variables > Actions (SUPABASE_*)
#   4. Redéployer Vercel (ou attendre le prochain push)
# Revert : recopier le bloc LEGACY vers le bloc ACTIF et redéployer.

# ── ACTIF (nouveau compte) ──────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx  # ou eyJhbGci...
SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── LEGACY (ancien compte — quota dépassé, gardé pour revert) ──
# VITE_SUPABASE_URL=https://bhbpvbfvuayafygdrbgb.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_TvmRepD1Trhu5bQIGZbkmg_YZ3FI3Gn
# SUPABASE_URL=https://bhbpvbfvuayafygdrbgb.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJoYnB2YmZ2dWF5YWZ5Z2RyYmdiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTU4MTA4MCwiZXhwIjoyMDk1MTU3MDgwfQ.vYD2hU9w8-42QSTWSP31qd7W0n1_KaDTiCWQKO96R10

# ── Optionnel : management API (migrations auto) ────────────
# SUPABASE_ACCESS_TOKEN=sbap_xxx

# ── Web Push (VAPID) — scripts/push-notifier.ts ────────────
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...  # NE JAMAIS committer — GitHub secret only
# VAPID_SUBJECT=mailto:you@example.com
